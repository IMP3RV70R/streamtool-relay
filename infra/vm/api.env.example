# Self-host container environment; bootstrap.py generates the installed version.
STREAMTOOL_ENV=production
SQLITE_PATH=/data/control.sqlite
SQLITE_MIGRATIONS_DIR=/sqlite-migrations
WEB_DIR=/web
ENVELOPE_PROVIDER=file
ENVELOPE_MANIFEST_FILE=/deployment/keyring.json
SETUP_TOKEN_FILE=/run/secrets/setup_token
API_ADMIN_TOKEN_FILE=/run/secrets/admin_token
EDGE_CONTROL_TOKEN_FILE=/run/secrets/edge_control_token
EDGE_READ_KEY_FILE=/run/secrets/edge_read_key
API_TLS_CERT_FILE=/certs/api.crt
API_TLS_KEY_FILE=/certs/api.key
TRUSTED_PROXY_CIDRS=172.30.80.3/32
EDGE_AUTH_ADDR=:8082
EDGE_AUTH_PEER_CIDRS=172.30.82.3/32
EDGE_AUTH_TLS_CERT_FILE=/certs/api.crt
EDGE_AUTH_TLS_KEY_FILE=/certs/api.key
MEDIA_NODES_FILE=/deployment/media-node.json
AGENT_CA_FILE=/certs/ca.crt
CONTROLLER_CERT_FILE=/certs/controller.crt
CONTROLLER_KEY_FILE=/certs/controller.key
NODE_REGION=local
WORKER_IMAGE=DEPLOYMENT_WORKER_IMAGE_ID
EDGE_ID=selfhost-edge
EDGE_API_URL=https://edge:9997
EDGE_API_CA_FILE=/certs/ca.crt
EDGE_SRT_URL=srt://172.30.81.2:8890
PUBLIC_RTMP_URL=rtmp://stream.example.com:1935
PUBLIC_SRT_URL=srt://stream.example.com:8890
